# MEDFUT: el navegador debe revalidar páginas y recursos en cada carga (evita ver versiones viejas en caché).
# Con ETag/Last-Modified, si el archivo no cambió el servidor responde 304 y no se vuelve a descargar.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Subida de Excel grandes (p. ej. exports de ~60 MB): el tope por defecto de PHP es 40 MB.
# Solo aplica con mod_php de Apache; no requiere reiniciar ni editar php.ini.
<IfModule php_module>
  php_value upload_max_filesize 256M
  php_value post_max_size 256M
</IfModule>
